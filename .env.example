# Copy to .env for `docker compose up --build`. Never commit the populated .env.
# Use URL-safe alphanumeric characters for POSTGRES_PASSWORD in compose's DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_ALPHANUMERIC_PASSWORD
# Generate with: openssl rand -hex 32   (64 hex characters; keep permanently)
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
WEB_ORIGIN=http://localhost:3000
# Empty uses the panel host with port 4000 in the browser. Set this to the
# browser-reachable API origin for split-host or reverse-proxy deployments.
NEXT_PUBLIC_API_URL=

GITHUB_REPOSITORY=kavaliersdelikt/fledge
# Optional: fine-grained token with read-only Contents/Metadata access for private release checks.
GITHUB_TOKEN=
APP_VERSION=0.1.3
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1
# Optional S3-compatible off-node storage. Use a HTTPS host reachable from API,
# EVERY game node and the browser; never use an internal Docker service hostname.
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_ENDPOINT=
# Explicitly allow additional vetted custom image prefixes here if needed.
ALLOWED_IMAGE_PREFIXES=itzg/minecraft-server:,ghcr.io/lloesche/valheim-server:

