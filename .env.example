# Copy to .env for `docker compose up --build`. Never commit the populated .env.
# Use URL-safe alphanumeric characters for POSTGRES_PASSWORD in compose's DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_ALPHANUMERIC_PASSWORD
# Generate with: openssl rand -hex 32   (64 hex characters; keep permanently)
ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
WEB_ORIGIN=http://localhost:3000
# Empty uses the panel host with port 4000 in the browser. Set this to the
# browser-reachable API origin for split-host or reverse-proxy deployments.
NEXT_PUBLIC_API_URL=

GITHUB_REPOSITORY=kavaliersdelikt/fledge
# Optional: fine-grained token with read-only Contents/Metadata access for private release checks.
GITHUB_TOKEN=
APP_VERSION=0.7.1.1
API_BIND=127.0.0.1
WEB_BIND=127.0.0.1
# Everything below is OPTIONAL. Object storage (backups), SFTP, allowed images and update
# sources are configured in the panel under Settings and stored encrypted in the database.
# These values only seed the panel before the first save.
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_ENDPOINT=
ALLOWED_IMAGE_PREFIXES=itzg/minecraft-server:,itzg/minecraft-bedrock-server:,ghcr.io/lloesche/valheim-server:,node:,python:,oven/bun:,golang:,eclipse-temurin:,php:,ruby:,mcr.microsoft.com/dotnet/

# Behind a reverse proxy, set the number of proxy hops (usually 1) so rate limits and the admin network
# allow-list see the real client address. Also accepts a comma-separated list of proxy addresses or ranges.
# Leave unset when the API is exposed directly.
# TRUST_PROXY=1

# Optional seeds for settings that are otherwise managed in the panel (Settings → Panel). They only
# apply until the matching section is saved in the panel; from then on the database wins.
# Plugin registry index (HTTPS). Empty turns the registry off; bundled plugins always work.
# PLUGIN_REGISTRY_URL=https://raw.githubusercontent.com/kavaliersdelikt/fledge/main/plugins/registry/index.json
# Outgoing email for invitations, password reset and email notifications.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls   # none | starttls | tls
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Fledge <fledge@example.com>
# Passkeys use the panel origin (WEB_ORIGIN). Set these only for unusual setups, e.g. several panel host names.
# WEBAUTHN_RP_ID=panel.example.com
# WEBAUTHN_ORIGINS=https://panel.example.com
# Break-glass: ignore the administrator network allow-list (Settings → Security) if you locked yourself out.
# ADMIN_IP_ALLOW_DISABLE=true

# Appearance (Settings → Appearance). Most of it is managed in the panel.
# Break-glass: show the built-in Fledge look and refuse appearance changes, for example after a theme made the panel hard to use.
# BRANDING_DISABLED=true
# Name the panel before an administrator has saved any appearance settings.
# BRAND_NAME=My Game Hosting
# How the panel's server reaches the API (Docker Compose sets this for you).
# API_INTERNAL_URL=http://api:4000
