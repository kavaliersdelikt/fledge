{
  "name": "fledge-api",
  "version": "0.9.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "check": "tsc --noEmit",
    "test:cors": "tsx --test test/cors.test.ts",
    "test:unit": "tsx --test test/unit.test.ts ../shared/theme.test.ts",
    "test:updates": "tsx test/updates-smoke.ts",
    "test:templates": "tsx --test test/pterodactyl.test.ts",
    "test:plugins": "node --import tsx test/plugins-smoke.mjs && node --import tsx test/plugins-security.mjs && tsx --test test/pack-tool.test.ts",
    "test:templates-v2": "node --import tsx test/templates-smoke.mjs",
    "test:fit": "node --import tsx test/fit-smoke.mjs",
    "test:autopilot": "node --import tsx test/autopilot-smoke.mjs",
    "test:accounts": "node --import tsx test/accounts-smoke.mjs",
    "test:branding": "tsx --test test/branding.test.ts && node --import tsx test/branding-smoke.mjs",
    "test:rookery": "tsx --test test/rookery.test.ts && node --import tsx test/rookery-smoke.mjs",
    "test:discord": "tsx --test test/discord-embeds.test.ts && node --import tsx test/discord-smoke.mjs",
    "test:billing": "node --test test/stripe-mock.test.mjs && node --import tsx test/billing-smoke.mjs",
    "test:mews": "tsx --test test/mews.test.ts && node --import tsx test/mews-smoke.mjs && node --import tsx test/mews-security.mjs && node --import tsx test/mews-edges.mjs && node --import tsx test/mews-upgrade.mjs && node --import tsx test/mews-billing.mjs && node --import tsx test/mews-transfer.mjs",
    "test:team": "node --import tsx test/mews-security.mjs && node --import tsx test/mews-transfer.mjs",
    "test:suspension": "node --import tsx test/mews-smoke.mjs && node --import tsx test/mews-edges.mjs && node --import tsx test/mews-billing.mjs",
    "test:support": "tsx --test test/mews.test.ts && node --import tsx test/mews-smoke.mjs && node --import tsx test/mews-security.mjs && node --import tsx test/mews-edges.mjs",
    "test:vm": "node --import tsx test/vm-smoke.mjs",
    "test:usage": "tsx --test test/usage.test.ts && node --import tsx test/usage-smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "bcryptjs": "^3.0.2",
    "cron-parser": "^5.10.1",
    "fastify": "^5.6.0",
    "fflate": "^0.8.3",
    "nodemailer": "^10.0.13",
    "otplib": "^12.0.1",
    "pg": "^8.16.3",
    "redis": "^6.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/smtp-server": "^3.5.13",
    "@types/ws": "^8.18.2",
    "cbor-x": "^1.6.6",
    "mailparser": "^3.9.33",
    "smtp-server": "^3.19.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
